# ---- Python ----------------------------------------------------------------
__pycache__/
*.pyc
.venv/
venv/

# ---- secrets ---------------------------------------------------------------
.env

# ---- editors ---------------------------------------------------------------
.vscode/
.idea/

# ---- derived data ----------------------------------------------------------
# data/ holds chunks.json and embeddings.npy, both REGENERATED by
# `manage.py ingest` from content/*.txt. Derived, so not committed.
#
# content/ is the opposite and IS committed: a person typed it, it is the only
# copy, and losing it means asking someone to remember it again. Scoped paths
# rather than bare filenames, so these rules cannot quietly match something
# else later.
data/
.model_cache/
